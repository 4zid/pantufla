# Sanity — https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Token con permiso de escritura, solo para guardar los briefs que llegan del formulario.
# Sanity Manage > API > Tokens > Editor
SANITY_API_WRITE_TOKEN=

# Resend — https://resend.com/api-keys (opcional: si no está, el brief igual se guarda en Sanity)
RESEND_API_KEY=
BRIEF_NOTIFICATION_TO=hola@pantufla.studio
BRIEF_NOTIFICATION_FROM=brief@pantufla.studio

# URL pública del sitio (para sitemap y metadatos)
NEXT_PUBLIC_SITE_URL=https://pantufla.studio
